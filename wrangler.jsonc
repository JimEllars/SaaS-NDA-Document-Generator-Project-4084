{
  "name": "axim-nda-generator-worker",
  "main": "worker.js",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "BACKEND_URL": "https://axim-payment-backend.jrellars.workers.dev",
    "AXIM_TELEMETRY_URL": "https://core.axim.us.com/api/v1/telemetry/ingest"
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "AXIM_EDGE_KV",
      "id": "REPLACE_WITH_PRODUCTION_KV_NAMESPACE_ID",
      "preview_id": "REPLACE_WITH_PREVIEW_KV_NAMESPACE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
