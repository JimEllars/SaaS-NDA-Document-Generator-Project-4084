# Frontend environment variables (Vite / Pages build)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_...
VITE_ENABLE_WEB3=false
# Leave empty in production so frontend calls same-origin worker routes.
VITE_PAYMENT_API_URL=
VITE_TELEMETRY_URL=
VITE_TELEMETRY_DIAGNOSTICS_URL=

# Local-only helper for admin dashboard polling.
# Do not expose production service keys in browser vars.
VITE_ADMIN_MONITOR_KEY=

# Worker runtime vars (set in wrangler.jsonc or Cloudflare dashboard vars)
BACKEND_URL=https://api.axim.us.com
AXIM_ENV=production

# Worker runtime secrets (set with `wrangler secret put`, never commit):
# AXIM_CORE_API_KEY
# AXIM_CORE_TOKEN
# TURNSTILE_SECRET_KEY
# STRIPE_WEBHOOK_SECRET
